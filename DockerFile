# Stage 1: Build the Spring Boot application using Java 21
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

# Copy Maven project files
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .

# Make Maven wrapper executable
RUN chmod +x mvnw

# Download dependencies first
RUN ./mvnw -B dependency:go-offline

# Copy application source code
COPY src src

# Build the application
RUN ./mvnw -B clean package -DskipTests

# Stage 2: Run the application using Java 21
FROM eclipse-temurin:21-jre

WORKDIR /app

# Copy the built Spring Boot JAR from the build stage
COPY --from=build /app/target/*.jar app.jar

# Render provides the port through the PORT environment variable
EXPOSE 8080

# Start the application
ENTRYPOINT ["sh", "-c", "java -Dserver.port=${PORT:-8080} -jar app.jar"]